<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Виджет включён в APK сразу, флаг widget управляет только содержимым
          (решение владельца 02.10.2026). Включать компонент из приложения
          нельзя: One UI 4.1 (Samsung SM-G970F) не регистрирует провайдер,
          включённый после установки, — даже после перезагрузки; проба-копия,
          включённая в манифесте, регистрировалась (docs/mobile.md).
          ⚠️ Класс назван DayWidgetReceiver, а не прежним DayWidgetProvider
          намеренно: у прежнего имени на телефонах осталось состояние,
          выставленное старым APK (выключен у тех, у кого не было флага), и
          оно пережило бы обновление. Новое имя — компонент без истории.
        -->
        <receiver
            android:name="ru.aristeatime.widget.DayWidgetReceiver"
            android:label="@string/aristea_widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/aristea_widget_info" />
        </receiver>
    </application>
</manifest>

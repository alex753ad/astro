<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 (наброски docs/widget_sketches, ветка wip/tariffs-pdf). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aristea_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/aristea_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/aristea_widget_kicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textColor="@color/aristea_widget_line"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/aristea_widget_moon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no" />

        <!-- Распорка — FrameLayout, а не View: голый View в RemoteViews запрещён,
             лаунчер покажет «Не удалось загрузить виджет». -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/aristea_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="2"
            android:textColor="@color/aristea_widget_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/aristea_widget_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/aristea_widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="11dp"
        android:importantForAccessibility="no"
        android:src="@drawable/aristea_widget_mark" />
</FrameLayout>

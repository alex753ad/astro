# .env.mobile — переменные сборки ТОЛЬКО для Capacitor-бандла.
#
# Vite читает этот файл исключительно при `--mode mobile` (см. build:mobile в
# package.json). Веб собирается в режиме production, локальная разработка — в
# development; ни та, ни другая этот файл не видят, поэтому появление здесь
# любой переменной не может изменить поведение веб-сборки или SSR.
#
# Файл коммитится намеренно: секретов в нём нет, а CI обязан собрать
# мобильный бандл без дополнительных настроек репозитория.

# Приложение в webview грузится с локального origin (https://localhost) и
# относительный /api/v1 указывал бы внутрь APK. Абсолютный адрес попадает в
# бандл через src/config.js, который уже читает VITE_API_URL с фолбэком на
# относительный путь для веба.
# 14.09.2026: адрес переведён с www на канонический apex. На УЖЕ УСТАНОВЛЕННЫЕ
# приложения это не влияет никак — там в бандле остался www, и ради них /api/
# навсегда исключён из редиректа www -> apex (см. astreatime.conf, редиректный
# сервер). Здесь правка на будущее: новые сборки не должны плодить клиентов,
# зависящих от исключения.
VITE_API_URL=https://aristeatime.ru/api/v1

# Включает мобильный транспорт refresh-токена (src/api/authTransport.js):
# заголовок X-Client-Platform, refresh в теле ответа, хранение в нативном
# Preferences вместо HttpOnly-куки, которую webview получить не может.
#
# В веб-сборке эта переменная не задана, выражение сворачивается в false ещё
# на этапе сборки, и весь мобильный код выпадает из бандла. Проверяется в CI
# грепом по dist — веб не должен содержать ни заголовка, ни @capacitor/preferences.
VITE_MOBILE=true

# Sentry приложения (src/main.mobile.jsx). Пусто — SDK в APK не попадает и
# ничего не отправляется. DSN не секрет: он и так лежит внутри каждого APK.
VITE_SENTRY_DSN=https://6a2024c69e2662047bc0a755e95dd0a3@o4512140370051072.ingest.de.sentry.io/4512140395151440

{
  "name": "astro-spa-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node generate-sitemap.js && vite build",
    "build:mobile": "vite build --config vite.config.mobile.js --mode mobile",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx",
    "sitemap": "node generate-sitemap.js",
    "test": "TZ=UTC vitest run && TZ=Europe/Moscow vitest run",
    "assert-bundle": "node scripts/assert-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/preferences": "^7.0.4",
    "@sentry/react": "^8.0.0",
    "d3": "^7.9.0",
    "framer-motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.0",
    "vitest": "^4.1.10"
  }
}

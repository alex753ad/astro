# ── Секреты ──────────────────────────────────────────────────────────────────
# Ловим .env целиком одним правилом с явным исключением для примеров.
# Раньше правила были рассыпаны по файлу в пяти местах (.env, env, env.*,
# и ещё раз .env внизу), и один коммит уже снимал .env* из-под игнора — при
# такой россыпи это не бросается в глаза на ревью.
.env
.env.*
!.env.example
!*.env.example
deploy/opt-astro/.env
deploy/opt-astro/frontend.env
# Экспорт реальных секретов Railway
deploy/opt-astro/railway.txt

# SSH-ключи
deploy/deploy_ed25519
deploy/*_ed25519
deploy/*.pem
*.pem
id_ed25519
id_rsa

# Сессии Telegram-клиента — это готовый доступ к аккаунту
*.session
*.session-journal

# ── Базы и дампы ─────────────────────────────────────────────────────────────
# Локальные SQLite тестов содержат реальные данные вплоть до хешей паролей.
*.db
*.sqlite
*.sqlite3
*.dump
*.dump.gz
backups/

# ── Артефакты сборки и кэши ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
node_modules/
frontend/dist/
.vercel
# Перегенерируется на каждой сборке — generate-sitemap.js, вызывается из
# npm run build (frontend/package.json). Без данных, зависящих от репозитория:
# фиксированный список маршрутов + сегодняшняя дата.
frontend/public/sitemap.xml

# ── Логи и мусор ─────────────────────────────────────────────────────────────
*.log
log.json
.DS_Store
Thumbs.db
*.bak
*.orig
*.rej

# ── Инструменты ──────────────────────────────────────────────────────────────
.aider*
.claude/worktrees/

# Локальное состояние celery beat (SQLite shelve + WAL) — плодится при любом
# локальном запуске `celery -A backend.celery_app beat`, машинно-зависимое.
celerybeat-schedule*

# ── Случайные коммиты, вычищенные из git rm --cached ──────────────────────────
# Сгенерированный PDF, забытый патч и скрейпленный список Telegram-каналов —
# ни один код на них не ссылается, попали в репозиторий по ошибке ручных
# правок. Файлы поимённо, а не *.pdf/*.patch: у проекта есть легитимные PDF
# (например натальные отчёты, если их когда-нибудь понадобится приложить как
# фикстуру теста) — широкий паттерн поймал бы и их.
/natal_chart.pdf
/push_notifications.patch
/astro_channels.csv
/astro_channels.json

# ── Локальный скрипт уведомлений ──────────────────────────────────────────────
# notify.py шлёт сообщение в Telegram и держит боевой токен бота открытым
# текстом. Файл нетрекнутый, а gitleaks в CI untracked-файлы НЕ видит — то
# есть до этой строки его от коммита не защищало ничто, кроме внимания: любой
# `git add -A` (а во время массовых правок соблазн максимальный) утащил бы
# токен в публичную историю, откуда его уже не убрать без перезаписи веток.
# Скрипт личный и на сервере не нужен — остаётся только локально.
/notify.py

# ── Мобильная сборка (Capacitor / Android) ─────────────────────────────────
# dist-mobile — артефакт 
pm run build:mobile, пересобирается каждой сборкой.
# frontend/android/ — сгенерированный Gradle-проект: CI создаёт его заново
# через 
px cap add android. Когда понадобятся правки нативной части
# (иконка, разрешения, AndroidManifest), это решение придётся пересмотреть —
# подробности в frontend/CAPACITOR.md.
# Keystore не хранится в git ни при каких условиях: по нему подписываются все
# будущие обновления приложения.
frontend/dist-mobile/
frontend/android/
# Исключение из правила .env.* выше: .env.mobile секретов не содержит (там
# один публичный адрес API) и обязан быть в репозитории — без него CI соберёт
# мобильный бандл с относительным /api/v1, то есть с неработающей сетью.
!frontend/.env.mobile
frontend/.capacitor/
frontend/capacitor.config.local.*
*.keystore
*.jks
# /opt/astro/frontend.env — build-time секреты фронтенда (VITE_*).
# Копируется в frontend.env рядом с docker-compose.yml, НЕ внутри app/.
# Читается 04-frontend-deploy.sh перед `npm run build`. В git не попадает.
#
# Живёт вне app/ намеренно: это git-репозиторий, `git pull` не должен
# ни затирать этот файл, ни рисковать случайно закоммитить секрет.

VITE_GOOGLE_CLIENT_ID=

# Sentry — optional (error tracking disabled without it)
VITE_SENTRY_DSN=

# /opt/astro/frontend.env — build-time секреты фронтенда (VITE_*).
# Копируется в frontend.env рядом с docker-compose.yml, НЕ внутри app/.
# Читается 04-frontend-deploy.sh перед `npm run build`. В git не попадает.
#
# Живёт вне app/ намеренно: это git-репозиторий, `git pull` не должен
# ни затирать этот файл, ни рисковать случайно закоммитить секрет.

VITE_GOOGLE_CLIENT_ID=

# Sentry — optional (error tracking disabled without it)
VITE_SENTRY_DSN=

# Обе ниже используются в коде (config.js:1, analytics.js:25), но в этом
# примере отсутствовали до 02.09.2026 — ровно тот способ, которым переменная
# теряется незаметно: раз её нет в примере, её не заводят на сервере, а сборка
# молча выбрасывает зависящий от неё код (Vite подставляет VITE_* как
# константы времени сборки, см. scripts/assert-bundle.mjs).
#
# Пустые значения здесь допустимы и осмысленны:
#   VITE_API_URL пуст       -> фронт ходит на относительный /api/v1, рабочий
#                              вариант, когда фронт и API на одном домене;
#   VITE_YANDEX_METRIKA_ID  -> счётчик не грузится вовсе.
VITE_API_URL=
VITE_YANDEX_METRIKA_ID=

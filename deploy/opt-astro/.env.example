# /opt/astro/.env — production environment for docker-compose.yml
# Copy to .env, fill in real values. Never commit the filled-in file.
# "required" = app breaks or a feature 503s without it. "optional" = feature silently degrades.

# ==================================================================
# Database (postgres service + api/bot connection string)
# ==================================================================
POSTGRES_USER=astro
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=astro_db
# Must use scheme postgresql:// (not postgres://) — SQLAlchemy 2.x rejects the short form.
# Host is the compose service name "postgres", not localhost.
DATABASE_URL=postgresql://astro:CHANGE_ME_STRONG_PASSWORD@postgres:5432/astro_db

# ==================================================================
# Redis (cache, rate limiting; NOT used as Celery broker in this deployment)
# ==================================================================
# REDIS_PASSWORD is required: the redis container refuses to start without it
# (see docker-compose.yml). Before it existed, any container on astro_net had
# full access to SSE tickets, the JWT denylist, rate-limit counters and the
# server-side RAG chat history.
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# The password must also be in the URL — same value as above.
REDIS_URL=redis://:CHANGE_ME_STRONG_PASSWORD@redis:6379/0

# ==================================================================
# Backups (07-backup-cron.sh) — required
# ==================================================================
# The dump holds every user's personal data, bcrypt password hashes and the
# payment history. It used to sit unencrypted next to the database it came
# from: one disk failure or one break-in meant losing the backups AND leaking
# them at the same time. The script now refuses to run without a recipient.
#
# Generate the key pair ON YOUR OWN MACHINE, never on the server:
#   age-keygen -o astro-backup.key
# Put only the public "age1..." line here. The server can encrypt but not
# decrypt — that is the whole point.
# Comma-separated for several recipients (e.g. you + a colleague).
BACKUP_AGE_RECIPIENTS=
# Alternative: path to a file with one public key per line.
BACKUP_AGE_RECIPIENTS_FILE=
# Off-host copy. Empty = local only (not recommended).
# rclone remote ("astro-s3:astro-backups/db") or s3:// URL for aws-cli.
BACKUP_S3_TARGET=

# ==================================================================
# Core / security — required
# ==================================================================
# Generate with: openssl rand -hex 32   (min 32 chars, app refuses to start below that outside DEBUG/TESTING)
JWT_SECRET=
JWT_SECRET_PREV=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
DEBUG=false
TESTING=false

# IP(s) trusted to set X-Forwarded-For — this is nginx-on-host talking to the api
# container through the published port. With astro_net's fixed subnet (172.28.0.0/16)
# the docker bridge gateway is 172.28.0.1; verify with `docker network inspect astro_net`.
TRUSTED_PROXY_IPS=172.28.0.1

# YooKassa. REQUIRED in production since 2026-08-23: the app refuses to start and
# 05-update.sh aborts the deploy if either is missing (see CLAUDE.md). Both empty
# used to mean "payments off" — that silently disabled checkout after the shop
# went live, which is why it is fatal now. Live key only: a key starting with
# test_ is rejected, subscriptions would be granted without real payment.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

RATE_LIMIT_STORAGE_URI=
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_ANON=30/minute
RATE_LIMIT_AUTH=100/minute
RATE_LIMIT_FREE_CHARTS_PER_DAY=5
RATE_LIMIT_FREE_INTERPRETATIONS_PER_DAY=2
SSE_TICKET_TTL_SECONDS=60
ANON_CHART_TTL_DAYS=30

# ==================================================================
# AI providers — optional individually, but ANTHROPIC_API_KEY is required
# for /forecast/weekly, /calendar/monthly and the planner (no fallback there)
# ==================================================================
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=10.0
AI_MAX_RETRIES=3

# ==================================================================
# Payments — Robokassa and Stripe removed as dead code (2026-08-19, no
# merchant account was ever set up, no real payment ever went through).
# Variables come back under ЮKassa as a separate task — bring back the
# matching prod guards in backend/main.py and deploy/opt-astro/05-update.sh
# at the same time (see CLAUDE.md).
# ==================================================================

# ==================================================================
# Google OAuth — optional (Google sign-in disabled without it)
# ==================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==================================================================
# Email (Resend) — optional (email sending disabled without it)
# ==================================================================
RESEND_API_KEY=
FROM_EMAIL=noreply@astreatime.ru
APP_URL=https://astreatime.ru
FRONTEND_URL=https://www.astreatime.ru
PUBLIC_API_URL=https://astreatime.ru

# ==================================================================
# CORS
# ==================================================================
CORS_ORIGINS=https://www.astreatime.ru,https://astreatime.ru

# ==================================================================
# Web Push (VAPID) — optional (push disabled without it)
# ==================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@astreatime.ru

# ==================================================================
# Telegram — TELEGRAM_BOT_TOKEN required for the bot service to start
# ==================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
PILOT_CHANNEL_IDS=-1004475404200,-1001851972750
# Bot talks to the api container directly over astro_net, not through nginx.
BACKEND_URL=http://api:8000
INTERNAL_SECRET=
CHANNEL_LINKS=

# ==================================================================
# Pilot program — optional, has defaults
# ==================================================================
PILOT_DAYS=30
PILOT_TOKEN_TTL_MIN=60
CONTINUE_PRO_CODE=astropro90
CONTINUE_PRO_OFFER=
CONTINUE_DEADLINE=

# ==================================================================
# Sentry — optional (error tracking disabled without it)
# ==================================================================
SENTRY_DSN=

# ==================================================================
# Misc — optional
# ==================================================================
ADMIN_EMAIL=
NOMINATIM_CONTACT=https://astreatime.ru

# ==================================================================
# NOTE: PORT and EPHE_PATH are NOT read from this file.
# They are hardcoded in docker-compose.yml (api/bot `environment:` blocks)
# so the port mapping and the port uvicorn binds to can never drift apart.
# SERVICE_ROLE is likewise set directly per-service in docker-compose.yml.
# ==================================================================

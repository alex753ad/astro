# ── Database ──
DATABASE_URL=postgresql://astro:astro@localhost:5432/astro_db

# ── AI Providers ──
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_USD=10.0

# ── JWT ──
# Здесь ТОЛЬКО плейсхолдер. Настоящий секрет в .env.example — это публикация
# секрета: файл коммитится и уходит на GitHub. Ровно так и произошло однажды,
# причём тем же коммитом, что добавил механизм ротации.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<generate-me>
# При ротации: сначала добавь старый секрет сюда, потом смени JWT_SECRET выше.
# Через 7 дней (после истечения refresh-токенов) удали JWT_SECRET_PREV.
JWT_SECRET_PREV=

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ──
RATE_LIMIT_ANON=30/minute
RATE_LIMIT_AUTH=100/minute

# ── Ephemeris ──
EPHE_PATH=data/ephe

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Redis ──
# В docker-compose Redis запускается с --requirepass ${REDIS_PASSWORD} и без
# этой переменной не стартует. Пароль должен быть и в URL.
# Сгенерировать:  openssl rand -base64 32
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ── Email (Resend) ──
RESEND_API_KEY=re_...
FROM_EMAIL=onboarding@resend.dev
APP_URL=https://aristeatime.ru
FRONTEND_URL=https://aristeatime.ru

# ── Web Push (VAPID) ──
# Ключи генерируются один раз. Публичный ключ фронтенд получает через API,
# поэтому здесь нужны только серверные значения.
# VAPID_SUBJECT — контакт для push-сервисов: mailto:... или https://...
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@aristeatime.ru

# ── CORS — через ALLOWED_ORIGINS (не хардкод) ──
# Список через запятую или JSON-массив
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","https://aristeatime.ru","https://www.aristeatime.ru"]

# ── HTTPS redirect ──
# Установи true на продакшне — автоматически редиректит http → https
HTTPS_ONLY=false

# ── General ──
DEBUG=true
ENVIRONMENT=development

# ── Sentry ──
SENTRY_DSN=

# ── Служебные (cron) эндпоинты ──
# Общий секрет для /api/v1/internal/* (заголовок X-Internal-Secret). Пусто вне
# DEBUG/TESTING — приложение не стартует: без него выдача pilot-токенов и
# массовые рассылки остались бы открытыми.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SECRET=

# ── Платежи (ЮKassa) ──
# Robokassa и Stripe удалены как мёртвый код (19.08.2026, аккаунтов не было,
# ни одного платежа не проходило).
#
# Обе переменные пусты — платежи не активны, POST /payments/checkout отвечает
# 503. Это рабочее состояние для локальной разработки.
#
# Прод-гвард (backend/main.py и продублирован в deploy/opt-astro/05-update.sh):
#   • задана ровно одна из двух → старт и деплой падают;
#   • ключ начинается с test_ в боевом окружении → падают (в тестовом режиме
#     ЮKassa «оплата» проходит без денег — подписки выдавались бы бесплатно).
# YOOKASSA_SHOP_ID — идентификатор магазина из личного кабинета (у нас 1442186).
# YOOKASSA_SECRET_KEY — боевой секретный ключ, начинается с live_.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# ── Host header ──
# Список через запятую. Пусто = не проверять. В проде задать домены явно:
# ALLOWED_HOSTS=aristeatime.ru,www.aristeatime.ru
ALLOWED_HOSTS=

# ── Telegram (обратная связь и пилот-бот) ──
# TELEGRAM_BOT_TOKEN уже используется ботом пилота (@BotFather); тот же токен
# нужен и здесь — им отправляются жалобы/скриншоты в служебный чат поддержки.
# TELEGRAM_SUPPORT_CHAT_ID: создать канал, добавить бота администратором,
# отправить любое сообщение, дёрнуть https://api.telegram.org/bot<TOKEN>/getUpdates —
# там будет chat.id (для каналов отрицательный, вида -100...).
# Эти же две переменные читает локальный notify.py в корне репозитория —
# раньше он держал оба значения захардкоженными открытым текстом. Без них
# он падает с явным сообщением, а не отправляет молча в никуда.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=
